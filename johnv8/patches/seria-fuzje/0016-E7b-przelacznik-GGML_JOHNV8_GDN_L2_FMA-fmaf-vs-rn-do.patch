From d6709deff70a530220b8134dce5a349a892d3068 Mon Sep 17 00:00:00 2001
From: johnv8 <johnv8@users.noreply.github.com>
Date: Thu, 3 Sep 2026 00:22:54 +0200
Subject: [PATCH 16/34] E7b: przelacznik GGML_JOHNV8_GDN_L2_FMA (fmaf vs rn) do
 dopasowania bitow z norm.cu

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/gated_delta_net.cu | 38 +++++++++++++++++----------
 1 file changed, 24 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index a2d46ab..98b419c 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -12,6 +12,7 @@ gated_delta_net_cuda(const float * q,
                                      const float * pro_a,
                                      const int     l2_on,
                                      const float   l2_eps,
+                                     const int     l2_fma,
                                      const float * curr_state,
                                      float *       dst,
                                      float *       state,
@@ -90,10 +91,18 @@ gated_delta_net_cuda(const float * q,
         if (l2_on) {   // [johnv8] E7b: l2_norm jak norm.cu (blok = warp, kolumny lane + r*warp_size, ta sama kolejnosc sum)
             float tk = 0.0f;
             float tq = 0.0f;
+            if (l2_fma) {   // stock norm.cu: `tmp += xi*xi` skontraktowane do fma
 #pragma unroll
-            for (int r = 0; r < rows_per_lane; r++) {
-                tk += k_reg[r] * k_reg[r];
-                tq += q_reg[r] * q_reg[r];
+                for (int r = 0; r < rows_per_lane; r++) {
+                    tk = fmaf(k_reg[r], k_reg[r], tk);
+                    tq = fmaf(q_reg[r], q_reg[r], tq);
+                }
+            } else {        // wariant bez kontrakcji
+#pragma unroll
+                for (int r = 0; r < rows_per_lane; r++) {
+                    tk = __fadd_rn(tk, __fmul_rn(k_reg[r], k_reg[r]));
+                    tq = __fadd_rn(tq, __fmul_rn(q_reg[r], q_reg[r]));
+                }
             }
             tk = warp_reduce_sum<warp_size>(tk);
             tq = warp_reduce_sum<warp_size>(tq);
@@ -101,8 +110,8 @@ gated_delta_net_cuda(const float * q,
             const float sq = rsqrtf(fmaxf(tq, l2_eps * l2_eps));
 #pragma unroll
             for (int r = 0; r < rows_per_lane; r++) {
-                k_reg[r] = sk * k_reg[r];
-                q_reg[r] = sq * q_reg[r];
+                k_reg[r] = __fmul_rn(sk, k_reg[r]);
+                q_reg[r] = __fmul_rn(sq, q_reg[r]);
             }
         }
 
@@ -200,7 +209,7 @@ gated_delta_net_cuda(const float * q,
 template <bool KDA, bool keep_rs_t>
 static void launch_gated_delta_net(
         const float * q_d, const float * k_d, const float * v_d,
-        const float * g_d, const float * b_d, const float * pro_dt, const float * pro_a, int l2_on, float l2_eps, const float * s_d,
+        const float * g_d, const float * b_d, const float * pro_dt, const float * pro_a, int l2_on, float l2_eps, int l2_fma, const float * s_d,
         float * dst_d, float * state_d,
         int64_t S_v,   int64_t H, int64_t n_tokens, int64_t n_seqs,
         int64_t sq1,   int64_t sq2, int64_t sq3,
@@ -221,26 +230,26 @@ static void launch_gated_delta_net(
     switch (S_v) {
         case 16:
             ggml_cuda_kernel_launch(gated_delta_net_cuda<16, KDA, keep_rs_t>, launch_params,
-                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d, H,
+                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
             break;
         case 32:
             ggml_cuda_kernel_launch(gated_delta_net_cuda<32, KDA, keep_rs_t>, launch_params,
-                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d, H,
+                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
             break;
         case 64: {
             ggml_cuda_kernel_launch(gated_delta_net_cuda<64, KDA, keep_rs_t>, launch_params,
-                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d, H,
+                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
             break;
         }
         case 128: {
             ggml_cuda_kernel_launch(gated_delta_net_cuda<128, KDA, keep_rs_t>, launch_params,
-                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d, H,
+                q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
             break;
@@ -293,6 +302,7 @@ static void ggml_cuda_op_gated_delta_net_impl(
     // [johnv8] E7b: l2norm q/k w jadrze (op_params[3]=1, eps w op_params[2])
     const int   l2_on  = ggml_get_op_params_i32(dst, 3);
     const float l2_eps = ggml_get_op_params_f32(dst, 2);
+    static const int l2_fma = []() { const char * e = getenv("GGML_JOHNV8_GDN_L2_FMA"); return e == nullptr ? 1 : atoi(e); }();
 
     const float * s_d   = (const float *) src_state->data;
     float *       dst_d = (float *) dst->data;
@@ -335,21 +345,21 @@ static void ggml_cuda_op_gated_delta_net_impl(
 
     if (kda) {
         if (keep_rs) {
-            launch_gated_delta_net<true, true>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d,
+            launch_gated_delta_net<true, true>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
         } else {
-            launch_gated_delta_net<true, false>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d,
+            launch_gated_delta_net<true, false>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
         }
     } else {
         if (keep_rs) {
-            launch_gated_delta_net<false, true>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d,
+            launch_gated_delta_net<false, true>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
         } else {
-            launch_gated_delta_net<false, false>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, s_d, dst_d, state_d,
+            launch_gated_delta_net<false, false>(q_d, k_d, v_d, g_d, b_d, pro_dt, pro_a, l2_on, l2_eps, l2_fma, s_d, dst_d, state_d,
                 S_v, H, n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1, rq3, scale, state_slot_stride, K, stream);
         }
