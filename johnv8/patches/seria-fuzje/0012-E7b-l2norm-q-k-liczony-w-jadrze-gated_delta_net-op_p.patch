+void ggml_gated_delta_net_set_l2norm(struct ggml_tensor * gdn, float eps) {
+    GGML_ASSERT(gdn->op == GGML_OP_GATED_DELTA_NET);
+    GGML_ASSERT(eps >= 0.0f);
+    ggml_set_op_params_f32(gdn, 2, eps);
+    ggml_set_op_params_i32(gdn, 3, 1);
+}
