+static __global__ void johnv8_cpy_bytes16_kernel(const char * __restrict__ src, char * __restrict__ dst, const int64_t n) {
+    const int64_t i   = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t n16 = n / 16;
+    if (i < n16) {
+        ((uint4 *) dst)[i] = ((const uint4 *) src)[i];
+    } else if (i == n16) {
+        for (int64_t k = n16 * 16; k < n; k++) { dst[k] = src[k]; }
+    }
+}
+static __global__ void johnv8_cpy_bytes1_kernel(const char * __restrict__ src, char * __restrict__ dst, const int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) { dst[i] = src[i]; }
+}
+static __global__ void johnv8_cpy_bytes2d_kernel(const char * __restrict__ src, const int64_t spitch, char * __restrict__ dst, const int64_t dpitch,
+                                                 const int64_t width, const int64_t height) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= width * height) return;
+    const int64_t r = i / width, c = i - r * width;
+    dst[r * dpitch + c] = src[r * spitch + c];
+}
+static inline void johnv8_cpy_bytes_cuda(char * dst, const char * src, size_t n, cudaStream_t stream) {
+    if (n == 0) return;
+    const bool aligned = ((uintptr_t) dst % 16 == 0) && ((uintptr_t) src % 16 == 0);
+    const int64_t threads = aligned ? (int64_t) (n / 16 + 1) : (int64_t) n;
+    const int64_t blocks  = (threads + 255) / 256;
+    GGML_ASSERT(blocks <= INT_MAX);
+    const ggml_cuda_kernel_launch_params lp((dim3) (unsigned) blocks, (dim3) 256, (size_t) 0, stream);
+    if (aligned) { ggml_cuda_kernel_launch(johnv8_cpy_bytes16_kernel, lp, src, dst, (int64_t) n); }
+    else         { ggml_cuda_kernel_launch(johnv8_cpy_bytes1_kernel,  lp, src, dst, (int64_t) n); }
+}
+static inline void johnv8_cpy_bytes_2d_cuda(char * dst, size_t dpitch, const char * src, size_t spitch, size_t width, size_t height, cudaStream_t stream) {
+    const int64_t total = (int64_t) width * (int64_t) height;
+    if (total == 0) return;
+    const int64_t blocks = (total + 255) / 256;
+    GGML_ASSERT(blocks <= INT_MAX);
+    const ggml_cuda_kernel_launch_params lp((dim3) (unsigned) blocks, (dim3) 256, (size_t) 0, stream);
+    ggml_cuda_kernel_launch(johnv8_cpy_bytes2d_kernel, lp, src, (int64_t) spitch, dst, (int64_t) dpitch, (int64_t) width, (int64_t) height);
+}
