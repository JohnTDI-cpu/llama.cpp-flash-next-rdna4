+// ============================================================================================
+// [johnv8] E64: any-order z trackerem hazardow (patrz common.cuh: johnv8_anyorder, PLAN_ANYORDER.md)
+// Env: GGML_JOHNV8_ANYORDER=0|1|dry, GGML_JOHNV8_ANYORDER_STATS=1. Tylko HIP, tylko bez capture grafu.
+// ============================================================================================
+thread_local johnv8_anyorder * johnv8_ao_cur = nullptr;
+
+void johnv8_ao_stream_op(void) {
+    if (johnv8_ao_cur != nullptr) { johnv8_ao_cur->n_op++; johnv8_ao_cur->poisoned = true; if (johnv8_ao_cur->grant) { johnv8_ao_cur->grant = false; johnv8_ao_cur->st_deny[4]++; } }
+}
+
+static int johnv8_ao_mode_env() {
+    static const int m = []() {
+        const char * e = getenv("GGML_JOHNV8_ANYORDER");
+        if (e == nullptr) return 0;
+        if (strcmp(e, "dry") == 0) return 2;
+        return atoi(e) != 0 ? 1 : 0;
+    }();
+    return m;
+}
+static int johnv8_ao_minnodes_env() {
+    static const int v = getenv("GGML_JOHNV8_ANYORDER_MINNODES") ? atoi(getenv("GGML_JOHNV8_ANYORDER_MINNODES")) : 400;
+    return v;
+}
+static bool johnv8_ao_stats_env() {
+    static const bool v = getenv("GGML_JOHNV8_ANYORDER_STATS") != nullptr && atoi(getenv("GGML_JOHNV8_ANYORDER_STATS")) != 0;
+    return v;
+}
+
+static __global__ void johnv8_ao_join_kernel() {}
+
+static inline johnv8_ao_range johnv8_ao_range_of(const ggml_tensor * t) {
+    const size_t sz = t->buffer != nullptr ? ggml_backend_buft_get_alloc_size(t->buffer->buft, t) : ggml_nbytes(t);
+    const uintptr_t lo = (uintptr_t) t->data;
+    return { lo, lo + sz };
+}
+static inline bool johnv8_ao_overlaps(const johnv8_ao_range & a, const std::vector<johnv8_ao_range> & v) {
+    for (const auto & b : v) { if (a.lo < b.hi && b.lo < a.hi) return true; }
+    return false;
+}
+// zbiory W (dst wszystkich wezlow grupy) i R (wszystkie src) — nadzbior jest zawsze bezpieczny
+static int johnv8_ao_sets(const ggml_cgraph * cgraph, int i, int n, johnv8_ao_range * W, int * nw, johnv8_ao_range * R, int * nr) {
+    *nw = 0; *nr = 0;
+    n = std::min(n, cgraph->n_nodes - i);
+    if (n <= 1) {
+        const ggml_tensor * t = cgraph->nodes[i];
+        if (t->data != nullptr) { W[(*nw)++] = johnv8_ao_range_of(t); }
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            if (t->src[j] != nullptr && t->src[j]->data != nullptr) { R[(*nr)++] = johnv8_ao_range_of(t->src[j]); }
+        }
+        return n;
+    }
+    // grupa fuzji: jadro pisze tylko ostatni wezel (pozostale wyjscia deklaruje op przez johnv8_ao_declare),
+    // a czyta tylko src spoza grupy (posrednie wezly fuzji nigdy nie trafiaja do pamieci)
+    // W: ostatni wezel + kazdy wezel grupy, ktory ma konsumenta poza grupa (liczba uzyc > uzycia wewnatrz grupy)
+    // lub jest wyjsciem grafu — tylko takie tensory fuzja naprawde zapisuje.
+    for (int k = 0; k < n && *nw < 16; k++) {
+        const ggml_tensor * t = cgraph->nodes[i + k];
+        if (t->data == nullptr) continue;
+        bool out = (k == n - 1) || (t->flags & GGML_TENSOR_FLAG_OUTPUT) != 0;
+        if (!out) {
+            int uses_in = 0;
+            for (int m = 0; m < n; m++) {
+                if (m == k) continue;
+                const ggml_tensor * u = cgraph->nodes[i + m];
+                for (int j = 0; j < GGML_MAX_SRC; j++) { if (u->src[j] == t) { uses_in++; } }
+            }
+            out = ggml_node_get_use_count(cgraph, i + k) > uses_in;
+        }
+        if (out) { W[(*nw)++] = johnv8_ao_range_of(t); }
+    }
+    for (int k = 0; k < n; k++) {
+        const ggml_tensor * t = cgraph->nodes[i + k];
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            const ggml_tensor * src = t->src[j];
+            if (src == nullptr || src->data == nullptr || *nr >= 16 * GGML_MAX_SRC) continue;
+            bool inner = false;
+            for (int m = 0; m < n; m++) { if (src == cgraph->nodes[i + m]) { inner = true; break; } }
+            if (!inner) { R[(*nr)++] = johnv8_ao_range_of(src); }
+        }
+    }
+    return n;
+}
+
+// whitelista etapu 1: ops jednojadrowe, bez puli, czytajace tylko src i piszace dst (przez ggml_cuda_kernel_launch)
+static bool johnv8_ao_whitelisted(const ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_MUL_MAT:   // sciezki mmq/mmf/cublas odwoluja grant u wejscia; mmvf i mmvq (sloty q8 deklarowane) zostaja
+        case GGML_OP_MUL_MAT_ID:   // mmvq/mmvf wprost; ids-helper alokuje pule (revoke), fallback z memcpy (revoke)
+        case GGML_OP_ADD: case GGML_OP_SUB: case GGML_OP_MUL: case GGML_OP_DIV:
+        case GGML_OP_SCALE: case GGML_OP_RMS_NORM:
+        case GGML_OP_CPY: case GGML_OP_CONT: case GGML_OP_DUP: case GGML_OP_CONCAT: case GGML_OP_SET_ROWS:   // E64C: kopie przez kernel
+            return true;
+        case GGML_OP_UNARY:
+            return ggml_get_unary_op(node) != GGML_UNARY_OP_XIELU;
+        case GGML_OP_GLU: {
+            const ggml_glu_op g = ggml_get_glu_op(node);
+            return (g == GGML_GLU_OP_SWIGLU || g == GGML_GLU_OP_GEGLU || g == GGML_GLU_OP_REGLU) && ggml_get_op_params_f32(node, 3) == 0.0f;
+        }
+        case GGML_OP_ROPE: {
+            const int mode = ((const int32_t *) node->op_params)[2];
+            return mode == GGML_ROPE_TYPE_NEOX || mode == GGML_ROPE_TYPE_MROPE;
+        }
+        case GGML_OP_GET_ROWS: {
+            const ggml_type t = node->src[0]->type;
+            return t == GGML_TYPE_F32 || t == GGML_TYPE_F16 || t == GGML_TYPE_BF16;
+        }
+        default:
+            return false;
+    }
+}
+
+// prosba o grant dla grupy wezlow [i, i+n) — przed dispatchem
+static void johnv8_ao_request(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i, int n) {
+    johnv8_anyorder * ao = johnv8_ao_cur;
+    if (ao == nullptr) return;
+    ao->grant = false;
+    if (ctx.curr_stream_no != 0) { ao->st_deny[6]++; return; }
+    if (ao->poisoned)            { ao->st_deny[3]++; return; }
+    johnv8_ao_range W[16], R[16 * GGML_MAX_SRC]; int nw, nr;
+    johnv8_ao_sets(cgraph, i, n, W, &nw, R, &nr);
+    for (int k = 0; k < nw; k++) {
+        if (johnv8_ao_overlaps(W[k], ao->written)) { ao->st_deny[2]++; return; }   // WAW
+        if (johnv8_ao_overlaps(W[k], ao->read))    { ao->st_deny[1]++; return; }   // WAR
+    }
+    for (int k = 0; k < nr; k++) {
+        if (johnv8_ao_overlaps(R[k], ao->written)) { ao->st_deny[0]++; return; }   // RAW
+    }
+    ao->grant = true;
+    ao->st_grant[cgraph->nodes[i]->op]++;
+}
+
+// po dispatchu grupy: aktualizacja trackera
+static void johnv8_ao_commit(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i, int n) {
+    johnv8_anyorder * ao = johnv8_ao_cur;
+    if (ao == nullptr) return;
+    GGML_UNUSED(ctx);
+    ao->st_nodes++; ao->st_launch_barrier += ao->n_barrier; ao->st_launch_ao += ao->n_ao; ao->st_ops += ao->n_op;
+    if (ao->grant) { ao->grant = false; ao->st_deny[7]++; }   // grant niezuzyty (launch poza wrapperem lub brak launchu)
+    if (ao->n_barrier > 0 || ao->n_op > 0) {
+        // launch barierowy (F1) / operacja niekernelowa: wszystko wczesniejsze jest zakonczone
+        ao->written.clear(); ao->read.clear();
+        ao->poisoned = ao->n_op > 0;
+        if (ao->n_barrier > 0 && ao->n_op == 0) { ao->ao_since_barrier = 0; }
+    }
+    johnv8_ao_range W[16], R[16 * GGML_MAX_SRC]; int nw, nr;
+    johnv8_ao_sets(cgraph, i, n, W, &nw, R, &nr);
+    for (int k = 0; k < nw; k++) ao->written.push_back(W[k]);
+    for (int k = 0; k < nr; k++) ao->read.push_back(R[k]);
+    for (const auto & r : ao->extra_w) ao->written.push_back(r);
+    for (const auto & r : ao->extra_r) ao->read.push_back(r);
+    ao->extra_w.clear(); ao->extra_r.clear();
+    ao->n_barrier = 0; ao->n_ao = 0; ao->n_op = 0;
+}
+
+static void johnv8_ao_begin_graph(ggml_backend_cuda_context & ctx, bool enabled) {
+    johnv8_ao_cur = nullptr;
+    const int mode = johnv8_ao_mode_env();
+    if (mode == 0) return;
+#if !defined(GGML_USE_HIP)
+    GGML_UNUSED(ctx); GGML_UNUSED(enabled);
+    return;
+#else
+    if (!enabled) {
+        static bool said = false;
+        if (johnv8_ao_stats_env() && !said) { said = true; fprintf(stderr, "[johnv8-anyorder] graf z capture HIP -> any-order nieaktywny dla tego grafu (flaga nie przezywa capture)\n"); }
+        return;
+    }
+    johnv8_anyorder & ao = ctx.ao;
+    ao.mode = mode;
+    ao.written.clear(); ao.read.clear();
+    if (ao.written.capacity() < 4096) { ao.written.reserve(4096); ao.read.reserve(8192); }
+    ao.poisoned = true; ao.grant = false; ao.extra_w.clear(); ao.extra_r.clear();
+    ao.n_barrier = 0; ao.n_ao = 0; ao.n_op = 0; ao.ao_since_barrier = 0;
+    johnv8_ao_cur = &ao;
+#endif
+}
+
+static void johnv8_ao_end_graph(ggml_backend_cuda_context & ctx) {
+    johnv8_anyorder * ao = johnv8_ao_cur;
+    if (ao == nullptr) return;
+    if (ao->ao_since_barrier > 0) {
+        // ostatni pakiet na strumieniu ma byc barierowy (kopie schedulera / zdarzenia poza graph_compute)
+        if (ao->mode == 1) { johnv8_ao_join_kernel<<<1, 1, 0, ctx.stream()>>>(); CUDA_CHECK(cudaGetLastError()); }
+        ao->st_joins++;
+        ao->ao_since_barrier = 0;
+    }
+    ao->st_graphs++;
+    if (johnv8_ao_stats_env() && (ao->st_graphs % 64) == 0) {
+        const double g = (double) ao->st_graphs;
+        const double la = (double) ao->st_launch_ao, lb = (double) ao->st_launch_barrier;
+        fprintf(stderr, "[johnv8-anyorder] tryb=%s grafy=%lld wezly/graf=%.0f launch/graf: bariera %.0f any-order %.0f (%.1f%%) ops %.1f join %.2f | odmowy/graf: RAW %.0f WAR %.0f WAW %.0f poison %.0f revoke %.0f stream %.0f niezuzyte %.0f | granty/graf:",
+                ao->mode == 1 ? "ON" : "dry", (long long) ao->st_graphs, (double) ao->st_nodes / g, lb / g, la / g, 100.0 * la / std::max(1.0, la + lb),
+                (double) ao->st_ops / g, (double) ao->st_joins / g,
+                (double) ao->st_deny[0] / g, (double) ao->st_deny[1] / g, (double) ao->st_deny[2] / g, (double) ao->st_deny[3] / g,
+                (double) ao->st_deny[4] / g, (double) ao->st_deny[6] / g, (double) ao->st_deny[7] / g);
+        for (int op = 0; op < GGML_OP_COUNT; op++) { if (ao->st_grant[op] > 0) fprintf(stderr, " %s %.0f", ggml_op_name((ggml_op) op), (double) ao->st_grant[op] / g); }
+        fprintf(stderr, "\n");
+    }
+    johnv8_ao_cur = nullptr;
+}
